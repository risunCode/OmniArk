# Single service: API, dashboard, WebSocket, and proxy share this port.
# Railway supplies PORT automatically; do not configure DASHBOARD_PORT there.
PORT=12800

# API key (clients send as Authorization: Bearer <key>)
API_KEY=replace-with-a-long-random-api-key

# Database (SQLite)
DATABASE_PATH=./data/omniark.db

# Token encryption key (32 hex chars). install.ts generates one for you.
ENCRYPTION_KEY=replace-with-32-random-hex-characters
